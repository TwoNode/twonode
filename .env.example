# ==============================================================================
# TWONODE ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local (for local development) or .env.staging / .env.production
# for deployed environments. Fill in the values appropriate for your environment.
#
# IMPORTANT SECURITY RULES:
# - NEVER commit files containing real keys, passwords, or secrets (.env, .env.local, .env.staging).
# - Generate cryptographically strong random secrets for JWT_SECRET and COOKIE_ENCRYPTION_KEY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & HOST CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
ONLINE_BASE_URL=https://twonode.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Deployment Identifiers (automatically populated by Vercel in production)
# VERCEL_URL=twonode.vercel.app
# VERCEL_BRANCH_URL=twonode-git-dev.vercel.app
# VERCEL_ENV=development # development | preview | production

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Environments:
#   - Local Dev:   twonode_dev (or local docker postgres)
#   - Staging:     twonode_staging (Neon pooler or direct)
#   - Production:  twonode_db (Neon pooler or direct)
DATABASE_URL="postgresql://postgres:your_password@ep-twonode-pooler.eu-central-1.aws.neon.tech/twonode_dev?sslmode=require"

# ------------------------------------------------------------------------------
# 3. PLUGGABLE MULTI-PROVIDER FILE STORAGE (lib/storage/ & ADR-0012)
# ------------------------------------------------------------------------------
# Select the active storage provider for Surfboard, Reva, and CoD uploads:
# Options: s3 | cloudflare (or r2) | minio | supabase | cloudinary | vercel-blob | imagekit | local
STORAGE_PROVIDER=s3
SURFBOARD_STORAGE_PROVIDER=s3

# --- 3A. AWS S3 (Default) ---
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=twonode-uploads
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- 3B. Cloudflare R2 (S3-Compatible Object Storage) ---
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id_hex
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=twonode-r2-uploads
# Optional custom public domain or R2.dev domain for public previews
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-yourbucketid.r2.dev
CLOUDFLARE_R2_CUSTOM_DOMAIN=https://media.twonode.com

# --- 3C. MinIO (Self-Hosted S3-Compatible Object Storage) ---
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=twonode-uploads
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# --- 3D. Supabase Storage (S3-Compatible API) ---
# Project ref found under Supabase Dashboard -> Project Settings -> General
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# S3 Credentials generated under Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY_ID=your_supabase_s3_access_key_id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
SUPABASE_STORAGE_BUCKET_NAME=twonode-uploads
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# --- 3E. Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- 3F. Vercel Blob ---
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_xxxxxxxxxxxx

# --- 3G. ImageKit ---
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- 3H. Local Filesystem ('local') ---
# No external credentials needed! Saves directly to public/uploads/
# Perfect for offline development and local test suites.

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION, SESSIONS & SECURITY SECRETS
# ------------------------------------------------------------------------------
# 64+ char random hex string (e.g. generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
# 32-character string for AES cookie encryption
COOKIE_ENCRYPTION_KEY=32_characters_encryption_key___
# NextAuth / Auth.js secrets
AUTH_SECRET=your_nextauth_auth_secret_key_hex
NEXTAUTH_SECRET=your_nextauth_auth_secret_key_hex
NEXTAUTH_URL=http://localhost:3000
# Cryptographic secret for GBC Certificate OTP verification
CERTIFICATE_OTP_SECRET=your_certificate_otp_signing_secret_key
# Cryptographic secret for signing GBC ticket & attendee verification QR codes
QR_CODE_SECRET=your_qr_code_signing_secret_key
# Bearer secret for securing internal cron job endpoints (/api/cron/...)
CRON_SECRET=your_internal_cron_secret_token

# ------------------------------------------------------------------------------
# 5. KINDE AUTHENTICATION (@kinde-oss/kinde-auth-nextjs)
# ------------------------------------------------------------------------------
KINDE_CLIENT_ID=your_kinde_client_id
KINDE_CLIENT_SECRET=your_kinde_client_secret
KINDE_ISSUER_URL=https://yourcompany.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/api/auth/login_redirect
# Kinde Management API (Optional for automated user provisioning)
KINDE_AUTH_DOMAIN=https://yourcompany.kinde.com
KINDE_MANAGEMENT_API_TOKEN=your_kinde_management_api_m2m_token

# ------------------------------------------------------------------------------
# 6. PAYMENT INTEGRATIONS (Paystack & Remita)
# ------------------------------------------------------------------------------
# Active mode: test | live
PAYSTACK_MODE=test

# Server secret keys (PAYSTACK_SECRET_KEY is auto-mapped based on PAYSTACK_MODE if omitted)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_TEST_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_LIVE_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public keys
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_TEST_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_LIVE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Surfboard Paystack Recurring Subscription Plan Codes
SURF_MONTHLY=PLN_monthly_plan_code
SURF_QUARTERLY=PLN_quarterly_plan_code
SURF_YEARLY=PLN_yearly_plan_code

# Remita Payment Gateway
REMITA_PUBLIC_KEY=your_remita_public_key
REMITA_SECRET_KEY=your_remita_secret_key
REMITA_BILLER_PRODUCT_ID=your_remita_biller_product_id
REMITA_BASE_URL=https://remitademo.net # Demo: https://remitademo.net | Live: https://login.remita.net

# ------------------------------------------------------------------------------
# 7. EMAIL & SMTP NOTIFICATIONS (Nodemailer)
# ------------------------------------------------------------------------------
EMAIL_USER=notifications@twonode.com
EMAIL_PASS=your_smtp_app_password
DEV_EMAIL=dev@twonode.com
ADMIN_EMAIL=admin@twonode.com
WEBHOOK_EMAIL_TO=alerts@twonode.com

# ------------------------------------------------------------------------------
# 8. SMS & WHATSAPP NOTIFICATIONS
# ------------------------------------------------------------------------------
ENABLE_SMS_NOTIFICATIONS=false
SMS_GATEWAY_DOMAIN=https://api.sms-gateway.com

# Africa's Talking
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key

# Termii (Nigeria SMS & WhatsApp)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=TwoNode
TERMII_WHATSAPP_SENDER_ID=your_termii_whatsapp_device_id

# WhatsApp Service Provider: meta | twilio | termii
WHATSAPP_PROVIDER=meta
# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# 9. ARTIFICIAL INTELLIGENCE & GEOSPATIAL SERVICES
# ------------------------------------------------------------------------------
# OpenAI (Intelligence, Chat Assistants & Document Analysis)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps Platform (Server-side geocoding, boundary validation & Distance Matrix)
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Google Maps Platform (Client-side interactive map views)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 10. SPECIALIZED WEBHOOKS & EVENT METADATA
# ------------------------------------------------------------------------------
# HMAC / Authorization token for CoD Red Copy survey processing callbacks
REDCOPY_WEBHOOK_SECRET=your_redcopy_webhook_secret_token

# Public Event Metadata (Global Builders Conference)
NEXT_PUBLIC_EVENT_DATE="October 24, 2026"
NEXT_PUBLIC_EVENT_LOCATION="Lagos, Nigeria"
NEXT_PUBLIC_EVENT_VENUE="Landmark Centre, Victoria Island"
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 11. PUSH NOTIFICATIONS (Surfboard mobile app; lib/push/, TASK-0015 1I)
# ------------------------------------------------------------------------------
# Push is OFF unless this is exactly 1. With it unset every send is a no-op, so
# deploying the code changes nothing for anyone. Turn it on per environment only
# after the FCM and Apple push keys have been uploaded to EAS (the maintainer does
# that) and the migrations 20261028100000_device_tokens and
# 20261029100000_push_receipt_tickets have been applied. The receipts cron
# (/api/cron/push-receipts) uses CRON_SECRET like the reminder cron.
PUSH_ENABLED=0
# Optional: an Expo access token, when "enhanced security" is switched on for the
# project at expo.dev. Sent as a Bearer token to Expo's push service; never logged.
# EXPO_ACCESS_TOKEN=your_expo_access_token
