# Surfboard Plan Creation System Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# AWS S3 Configuration for Surfboard (Primary)
SURFBOARD_AWS_REGION=us-east-1
SURFBOARD_AWS_ACCESS_KEY_ID=your-surfboard-access-key
SURFBOARD_AWS_SECRET_ACCESS_KEY=your-surfboard-secret-key
SURFBOARD_AWS_BUCKET_NAME=your-surfboard-bucket-name

# AWS S3 Configuration for REVA (Fallback - if Surfboard config is not provided)
REVA_AWS_REGION=us-east-1
REVA_AWS_ACCESS_KEY_ID=your-reva-access-key
REVA_AWS_SECRET_ACCESS_KEY=your-reva-secret-key
REVA_AWS_BUCKET_NAME=your-reva-bucket-name

# Next.js Configuration
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Other Configuration
NODE_ENV=development 