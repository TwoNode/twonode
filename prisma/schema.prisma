// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model nigeria_ward_admin_boundaries {
  id         Int                      @id @default(autoincrement())
  geom       Unsupported("geometry")?
  wardname   String?                  @db.VarChar(112)
  lganame    String?                  @db.VarChar(44)
  statename  String?                  @db.VarChar(22)
  Shape_Leng Float?
  Shape_Area Float?
  lcdaname   String?                  @db.VarChar(254)

  @@index([geom], map: "sidx_nigeria_ward_admin_boundaries_geom", type: Gist)
}


/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}


model Property {
  id                     String   @id @default(uuid())
  reference              String   @unique @default(dbgenerated("concat('REVA_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 12))")) // Optional DB default if supported
  references             String[] // Other references for a transaction
  title                  String?  // Nullable
  description            String?  // Nullable

  status                 String?
  paymentStatus          String?

  paymentLink            String?  // Nullable

  statusMessage          String?  // Nullable
  error                  String?  // Nullable

  userId                 String
  user                   RevaUser @relation(fields: [userId], references: [id])

  address                String
  lat                    Float?
  lng                    Float?
  lga                    String
  parcelId               String?  // Optional

  totalCost              Float
  documentsUrls          String[] // Array of URLs
  site_images            String[] // Array of site image URLs
  comments               String?  // Optional
  deleted                Boolean   @default(false) // Optional field to indicate if the property is deleted
  isLive                 Boolean   @default(false) // Track if this is a live or test transaction

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  report                 Json?    // report from reva
}

model OneTimeUserProperty {
  id                     String   @id @default(uuid())
  reference              String   @unique @default(dbgenerated("concat('reva_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 12))")) // Optional DB default if supported
  requester              String?  // Nullable (default "")
  description            String?  // Nullable

  status                 String?
  paymentStatus          String?

  statusMessage          String?  // Nullable
  error                  String?  // Nullable

  email                  String
  userPhoneNumber        String?  // Optional

  address                String
  lat                    Float?
  lng                    Float?
  lga                    String
  parcelId               String?  // Optional

  totalCost              Float
  documentsUrls          String[] // Array of URLs
  site_images            String[] // Array of site image URLs
  comments               String?  // Optional
  isLive                 Boolean   @default(false) // Track if this is a live or test transaction

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  report                 Json?    // report from reva
}


enum Role {
  USER
  ADMIN
  SUPERADMIN
}


// Placeholder User model for relation
model RevaUser {
  id                 String              @id @default(uuid()) // Unique identifier
  kindeId            String              @unique
  email              String              @unique

  firstName          String
  lastName           String

  role               Role                @default(USER)
  emailVerified      Boolean             @default(false)
  is_active          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  properties         Property[]
}


enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  PAYMENT
  PROPERTY
}

enum NotificationAudience {
  SPECIFIC_USERS   // Targeted to specific userIds
  GENERAL_USERS    // General notification for regular users
  GENERAL_ADMINS   // General notification for admins
  SUPERADMIN       // General notification for superadmins
  ALL_USERS        // Everyone (users + admins + superadmins)
}


model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  message         String
  readBy          String[]         @default([]) // List of userIds who read it
  dismissedBy     String[]         @default([]) // List of userIds who dismissed it
  userIds         String[]         @default([]) // If null/empty => general
  audience        NotificationAudience @default(SPECIFIC_USERS)
  link            String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([createdAt])
  @@index([audience])
}






// --------------------------------------------------------------------------------
// Prisma schema for the Surfboard mapping application.
// Defines the PostGIS‐enabled Postgres schema for storing survey plans,
// with pillars stored as JSONB, and a simple status/isLive workflow.
// --------------------------------------------------------------------------------


enum SurfboardRole {
  USER
  ADMIN
  SUPERADMIN
  RECORDS_I // MDA Role: Verifies record copies
  RECORDS_II // MDA Role: Verifies physical copies and submits to OSSG
  ACCOUNTS // MDA Role: Approves LASG payment receipts
  CHARTING // MDA Role: Edits/confirms charting remarks
  SURCON // MDA Role: Confirms pillar numbers
  MDA_SUPERADMIN // MDA Role: Can view all activities of all MDA users
}

model SurfboardUser {
  id                       String        @id @default(uuid())
  kindeId                  String        @unique
  email                    String        @unique
  firstName                String
  lastName                 String
  role                     SurfboardRole @default(USER)
  emailVerified            Boolean       @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  isActive                 Boolean       @default(true)

  // New fields
  logo                String?                 // URL to the user's logo
  companyName         String?                 // User's company name
  companyAddress      String?                 // User's company address
  surconRegNumber     String?        @unique  @default(dbgenerated("concat('SURCON_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 5))"))
  surconRegName       String?                 // Name as registered with SURCON
  signature           String?                 // URL to the user's signature image
  prefix              String?                 // Name prefix (e.g., Mr., Mrs., Dr.)
  suffix              String?                 // Name suffix (e.g., Jr., Sr., III)
  residenceState      String?                 // Residence state in Nigeria
  postalCode          String?                 // User's postal code

  // Relations
  plans               SurfboardPlan[]
  subscription        Subscription[]
  subscriptionHistory SubscriptionHistory[]
  batches             CertificateOfDepositBatch[]
  settingsUpdates     SurfboardSettings[]

  // Timestamps
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  metadata            Json?          @default("{}")

  @@map("SurfboardUser")
}

enum SurfboardPlanStatus {
  PENDING
  LODGED    // APPROVED
  QUERIED
  UNDER_REVIEW
}

enum SurfboardRedCopyStatus {
  NOT_SUBMITTED
  SUBMITTED
  COMPLETED
  FAILED
  APPROVED // Certificate of Deposit approved
  QUERIED // Queried by any MDA role
}

model Subscription {
  id     String        @id @default(uuid())
  userId String        @unique
  user   SurfboardUser @relation(fields: [userId], references: [id])

  provider            String                  @default("paystack")
  email               String?
  customerCode        String?
  customerId          String?
  emailToken          String?                 // required to enable/disable
  authorization       String?
  subCode             String?                 // Paystack subscription ID
  planCode            String
  planName            String
  interval            String                  @default("monthly") // 'monthly' | 'quarterly' | 'yearly'
  amount              Int
  currency            String                  @default("NGN")
  currentStart        DateTime?
  currentEnd          DateTime?
  cancelledAt         DateTime?
  nextPaymentDate     DateTime?
  status              String                  // active, canceled, expired, etc.
  platform            String                  @default("surfboard")  // surfboard or twonodes or reva or scram

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@map("Subscription")
}

model SubscriptionHistory {
  id                  String                  @id @default(uuid())
  reference           String

  userId              String
  user                SurfboardUser           @relation(fields: [userId], references: [id])

  planCode            String
  planName            String
  amount              Int                     // Amount in kobo
  interval            String                  @default("monthly") // 'monthly' | 'quarterly' | 'yearly'
  lastPaymentDate     DateTime?
  startDate           DateTime?
  endDate             DateTime?
  status              String                  // 'active' | 'past_due' | 'canceled'
  eventType           String                  // "subscription.create", "subscription.disable", "invoice.success", etc.

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([reference])
  @@map("SubscriptionHistory")
}

/// A single survey plan record.
/// Geometry is stored as raw GeoJSON in JSONB; pillars are in JSONB.
model SurfboardPlan {
  /// PK: auto-generated UUID
  id                     String               @id @default(uuid()) @db.Uuid

  /// User-entered reference number
  planNumber             String               @unique

  /// Descriptive title
  surveyTitle            String

  /// Category (e.g. APPROVED LAYOUT, DEED)
  planType               String

  /// Optional link to a previous plan
  referencePlanNumber    String?

  /// Recorded deeded area (free-text)
  deededArea             String

  /// Surveyor/facilitator name
  facilitator            String

  /// Type of survey pillar
  pillarType             String

  /// Raw GeoJSON polygon stored as JSONB
  geometry               Json

  /// S3 URLs for uploaded files
  pdfFilePaths           String[]          @default([])
  cadFilePaths           String[]          @default([])
  certificateFilePaths   String[]          @default([])

  /// Date when the plan was lodged
  dateLodged             DateTime?

  /// Red Copy submission status
  redCopyStatus          SurfboardRedCopyStatus @default(NOT_SUBMITTED) // NOT_SUBMITTED, SUBMITTED, COMPLETED, FAILED
  redCopySubmittedAt     DateTime?           // When the Red Copy was submitted
  redCopyFileUrl         String?             // URL to the uploaded Red Copy file
  redCopyError           String?             // Error message if Red Copy submission failed

  // Certificate of Deposit fields
  locality                String?            // New field for locality
  possibleChartingRemarks String?            // Populated from LASG_charting_interpretation
  chartingRemarks         String?            // Final charting remarks (edited by Charting Admin)
  batchId                 String?            // Reference to batch submission
  batch                   CertificateOfDepositBatch? @relation(fields: [batchId], references: [id])

  // Approval tracking
  accountsApprovedBy      String?
  accountsApprovedAt      DateTime?
  accountsStatus          ApprovalStatus? @default(PENDING)
  accountsComment         String?
  accountsLockedBy        String?            // User ID who locked this plan for accounts review
  accountsLockedAt        DateTime?          // When the lock was acquired
  accountsLockExpiresAt   DateTime?          // When the lock expires (30 min from lock time)

  chartingApprovedBy      String?
  chartingApprovedAt      DateTime?
  chartingStatus          ApprovalStatus? @default(PENDING)
  chartingComment         String?
  chartingLockedBy        String?            // User ID who locked this plan for charting review
  chartingLockedAt        DateTime?          // When the lock was acquired
  chartingLockExpiresAt   DateTime?          // When the lock expires

  surconApprovedBy        String?
  surconApprovedAt        DateTime?
  surconStatus            ApprovalStatus? @default(PENDING)
  surconComment           String?
  surconLockedBy          String?            // User ID who locked this plan for SURCON review
  surconLockedAt          DateTime?          // When the lock was acquired
  surconLockExpiresAt     DateTime?          // When the lock expires

  recordsIApprovedBy      String?
  recordsIApprovedAt      DateTime?
  recordsIStatus          ApprovalStatus? @default(PENDING)
  recordsIComment         String?
  recordsILockedBy        String?            // User ID who locked this plan for Records I review
  recordsILockedAt        DateTime?          // When the lock was acquired
  recordsILockExpiresAt   DateTime?          // When the lock expires

  recordsIIApprovedBy     String?
  recordsIIApprovedAt     DateTime?
  recordsIIStatus         ApprovalStatus? @default(PENDING)
  recordsIIComment        String?
  recordsIILockedBy       String?            // User ID who locked this plan for Records II review
  recordsIILockedAt       DateTime?          // When the lock was acquired
  recordsIILockExpiresAt  DateTime?          // When the lock expires

  // Location fields
  ward                   String?
  lcda                   String?
  lga                    String?
  state                  String?

  /// Array of pillar objects
  pillars                Json

  /// Date on the survey plan document
  dateOnSurveyPlan       DateTime?

  /// Reason required when planType is "Withdrawal and Resubmission"
  reasonForWithdrawalAndResubmission String?

  /// Workflow status (default PENDING)
  status                 SurfboardPlanStatus @default(PENDING)

  /// Draft vs. published
  isLive                 Boolean             @default(false)

  /// Reference to the user who created this plan
  userId                 String?
  user                   SurfboardUser?       @relation(fields: [userId], references: [id])

  sharedTo               String[]

  /// Soft delete fields
  deleted                Boolean             @default(false)
  deletedAt              DateTime?
  deletedBy              String?             // User ID who deleted the plan

  /// Creation & update timestamps
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  /// Index by reference number
  @@index([planNumber])
  @@index([deleted])
}

enum SurfboardNotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  PLAN
  SHARING
}

enum SurfboardNotificationAudience {
  SPECIFIC_USERS
  GENERAL_ADMINS
  SUPERADMIN
  ALL_USERS
}

model SurfboardNotification {
  id          String                        @id @default(cuid())
  type        SurfboardNotificationType
  title       String
  message     String
  readBy      String[]                      @default([]) // List of userIds who read it
  dismissedBy String[]                      @default([]) // List of userIds who dismissed it
  userIds     String[]                      @default([]) // If null/empty => general
  audience    SurfboardNotificationAudience @default(SPECIFIC_USERS)
  link        String?
  metadata    Json?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([createdAt])
  @@index([audience])
}

// --------------------------------------------------------------------------------
// Certificate of Deposit System
// --------------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  QUERIED
}

enum BatchPaymentStatus {
  PENDING_USER_PAYMENT
  USER_PAID
  PENDING_LASG_PAYMENT
  LASG_PAID
  ACCOUNTS_APPROVED
  ACCOUNTS_DISAPPROVED
  COMPLETED
}

/// LGA Fee Configuration - Editable by Super Admin
model LGAFeeConfig {
  id                  String   @id @default(uuid())
  lgaName             String   @unique
  ratePerSqM          Float // Rate per square meter in Naira
  systemChargePercent Float    @default(10) // System charge percentage
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([lgaName])
}

/// Certificate of Deposit Batch Submission
model CertificateOfDepositBatch {
  id        String @id @default(uuid())
  batchCode String @unique @default(dbgenerated("concat('SurfCoD_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 8))"))

  // Submitter
  submittedBy String
  submitter   SurfboardUser @relation(fields: [submittedBy], references: [id])

  // Plans in this batch
  plans     SurfboardPlan[]
  planCount Int             @default(0)

  // Fee Calculation
  totalFees     Float // Sum of all plan fees
  systemCharges Float // 10% of total fees
  totalAmount   Float // totalFees + systemCharges

  // Payment Status
  paymentStatus BatchPaymentStatus @default(PENDING_USER_PAYMENT)

  // User Payment (Fold 1)
  userPaymentRef String? @unique @default(dbgenerated("concat('SurfCoDRef_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 8))"))

  userPaymentDate   DateTime?
  userPaymentAmount Float?

  // LASG Payment (Fold 2)
  lasgReceiptUrl        String? // Uploaded receipt
  lasgReceiptS3Key      String?
  lasgPaymentDate       DateTime?
  lasgReceiptUploadedBy String?
  lasgReceiptUploadedAt DateTime?

  // Accounts Approval
  accountsApprovedBy  String?
  accountsApprovedAt  DateTime?
  accountsDisapproved Boolean   @default(false)
  accountsComment     String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchCode])
  @@index([submittedBy])
  @@index([paymentStatus])
}

/// LASG Charting Interpretation - PostGIS Dataset
model LASG_charting_interpretation {
  id             Int                      @id @default(autoincrement())
  geom           Unsupported("geometry")? // PostGIS geometry
  interpretation String? // Charting interpretation text

  @@index([geom], map: "sidx_lasg_charting_interpretation_geom", type: Gist)
}

/// Surfboard Application Settings
model SurfboardSettings {
  id        String   @id @default(cuid())
  /// Stores the entire application configuration as a JSON object.
  /// Structure: {
  ///   lgaFees: { "Eti-Osa": 10, "Ikeja": 8, ... }, // Rate per square meter in Naira
  ///   systemChargePercent: 10,
  ///   ... other settings
  /// }
  settings  Json     @default("{}")
  previousSettings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedById String?
  updatedBy   SurfboardUser? @relation(fields: [updatedById], references: [id])

  @@map("surfboard_settings")
}

// --------------------------------------------------------------------------------
// Prisma schema for the Surfboard mapping application.
// Defines the PostGIS‐enabled Postgres schema for storing survey plans,
// with pillars stored as JSONB, and a simple status/isLive workflow.
// --------------------------------------------------------------------------------

model WebhookEvent {
  id          String   @id @default(cuid())
  signature   String   @unique // x-paystack-signature; uniquely identifies a delivery payload
  event       String
  platform    String
  entityKey   String?  // e.g., sub:SUB_xxx, ref:PSK_REF_xxx, cus:CUS_xxx
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  status      String    // "pending" | "ok" | "error"
  error       String?

  @@index([event, platform])
  @@index([entityKey])
  @@index([receivedAt])
}

