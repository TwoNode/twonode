// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Property {
  id                     String   @id @default(uuid())
  reference              String   @unique @default(dbgenerated("concat('REVA_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 12))")) // Optional DB default if supported
  references             String[] // Other references for a transaction
  title                  String?  // Nullable
  description            String?  // Nullable

  status                 String?
  paymentStatus          String?

  paymentLink            String?  // Nullable

  statusMessage          String?  // Nullable
  error                  String?  // Nullable

  userId                 String
  user                   RevaUser @relation(fields: [userId], references: [id])

  address                String
  lat                    Float?
  lng                    Float?
  lga                    String
  parcelId               String?  // Optional

  totalCost              Float
  documentsUrls          String[] // Array of URLs
  site_images            String[] // Array of site image URLs
  comments               String?  // Optional
  deleted                Boolean   @default(false) // Optional field to indicate if the property is deleted
  isLive                 Boolean   @default(false) // Track if this is a live or test transaction

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  report                 Json?    // report from reva
}

model OneTimeUserProperty {
  id                     String   @id @default(uuid())
  reference              String   @unique @default(dbgenerated("concat('reva_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 12))")) // Optional DB default if supported
  requester              String?  // Nullable (default "")
  description            String?  // Nullable

  status                 String?
  paymentStatus          String?

  statusMessage          String?  // Nullable
  error                  String?  // Nullable

  email                  String
  userPhoneNumber        String?  // Optional

  address                String
  lat                    Float?
  lng                    Float?
  lga                    String
  parcelId               String?  // Optional

  totalCost              Float
  documentsUrls          String[] // Array of URLs
  site_images            String[] // Array of site image URLs
  comments               String?  // Optional
  isLive                 Boolean   @default(false) // Track if this is a live or test transaction

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  report                 Json?    // report from reva
}


enum Role {
  USER
  ADMIN
  SUPERADMIN
}


// Placeholder User model for relation
model RevaUser {
  id                 String              @id @default(uuid()) // Unique identifier
  kindeId            String              @unique
  email              String              @unique

  firstName          String
  lastName           String

  role               Role                @default(USER)
  emailVerified      Boolean             @default(false)
  is_active          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  properties         Property[]
}


enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  PAYMENT
  PROPERTY
}

enum NotificationAudience {
  SPECIFIC_USERS   // Targeted to specific userIds
  GENERAL_USERS    // General notification for regular users
  GENERAL_ADMINS   // General notification for admins
  SUPERADMIN       // General notification for superadmins
  ALL_USERS        // Everyone (users + admins + superadmins)
}


model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  message         String
  readBy          String[]         @default([]) // List of userIds who read it
  dismissedBy     String[]         @default([]) // List of userIds who dismissed it
  userIds         String[]         @default([]) // If null/empty => general
  audience        NotificationAudience @default(SPECIFIC_USERS)
  link            String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([createdAt])
  @@index([audience])
}

enum SurfboardRole {
  USER
  ADMIN
  SUPERADMIN
}

model SurfboardUser {
  id            String         @id @default(uuid())
  kindeId       String         @unique
  email         String         @unique
  firstName     String
  lastName      String
  role          SurfboardRole  @default(USER)
  emailVerified Boolean        @default(false)
  is_active     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  plans         SurfboardPlan[]
}

enum SurfboardNotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  PLAN
  SHARING
}

enum SurfboardNotificationAudience {
  SPECIFIC_USERS
  GENERAL_ADMINS
  SUPERADMIN
  ALL_USERS
}

model SurfboardNotification {
  id          String                        @id @default(cuid())
  type        SurfboardNotificationType
  title       String
  message     String
  readBy      String[]                      @default([]) // List of userIds who read it
  dismissedBy String[]                      @default([]) // List of userIds who dismissed it
  userIds     String[]                      @default([]) // If null/empty => general
  audience    SurfboardNotificationAudience @default(SPECIFIC_USERS)
  link        String?
  metadata    Json?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([createdAt])
  @@index([audience])
}

// Surfboard Plan Models
model SurfboardPlan {
  id                    String   @id @default(uuid())
  planNumber            String   @unique
  surveyTitle           String
  planType              String
  referencePlanNumber   String?
  deededArea            String
  facilitator           String
  pillarType            String
  certificateReady      String?
  
  // Administrative boundaries
  ward                  String?
  lcda                  String?
  lga                   String?
  
  // File paths
  pdfFilePath           String?
  cadFilePath           String?
  certificateFilePath   String?
  
  // Geometry (stored as GeoJSON string)
  geometry              String? // GeoJSON polygon
  areaSqM               Float?
  centroid              String? // GeoJSON point
  
  // Status and tracking
  status                String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewComments        String?
  
  // Relationships
  userId                String
  user                  SurfboardUser @relation(fields: [userId], references: [id])
  pillars               SurfboardPillar[]
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([planNumber])
}

model SurfboardPillar {
  id            String   @id @default(uuid())
  parcelId      String
  parcel        SurfboardPlan @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  
  // Coordinates
  easting       Float
  northing      Float
  pointIndex    Int
  pillarNumber  String
  
  // Geometry (stored as GeoJSON string)
  geometry      String? // GeoJSON point
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([parcelId])
  @@index([pillarNumber])
}
