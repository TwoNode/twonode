// --------------------------------------------------------------------------------
// REVA — Lagos property due-diligence and valuation platform.
// --------------------------------------------------------------------------------

model Property {
  id          String   @id @default(uuid())
  reference   String   @unique @default(dbgenerated("concat('REVA_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 12))")) // Optional DB default if supported
  references  String[] // Other references for a transaction
  title       String? // Nullable
  description String? // Nullable

  status        String?
  paymentStatus String?

  paymentLink String? // Nullable

  statusMessage String? // Nullable
  error         String? // Nullable

  userId String
  user   RevaUser @relation(fields: [userId], references: [id])

  address  String
  lat      Float?
  lng      Float?
  lga      String
  parcelId String? // Optional

  totalCost     Float
  documentsUrls String[] // Array of URLs
  site_images   String[] // Array of site image URLs
  comments      String? // Optional
  deleted       Boolean  @default(false) // Optional field to indicate if the property is deleted
  isLive        Boolean  @default(false) // Track if this is a live or test transaction

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report Json? // report from reva
}

model OneTimeUserProperty {
  id          String  @id @default(uuid())
  reference   String  @unique @default(dbgenerated("concat('reva_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 12))")) // Optional DB default if supported
  requester   String? // Nullable (default "")
  description String? // Nullable

  status        String?
  paymentStatus String?

  statusMessage String? // Nullable
  error         String? // Nullable

  email           String
  userPhoneNumber String? // Optional

  address  String
  lat      Float?
  lng      Float?
  lga      String
  parcelId String? // Optional

  totalCost     Float
  documentsUrls String[] // Array of URLs
  site_images   String[] // Array of site image URLs
  comments      String? // Optional
  isLive        Boolean  @default(false) // Track if this is a live or test transaction

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report Json? // report from reva
}

/// Short-lived download-gate code, requested fresh for every download
/// attempt (report or an original document) on the guest one-time-request
/// page and the authenticated user's own dashboard. Mirrors
/// EmailVerificationToken/PasswordResetToken's hashed-code + expiry +
/// single-use shape, but stores a short numeric code (a human types 6
/// digits) instead of a link token.
model DownloadOtp {
  id        String    @id @default(uuid())
  reference String // Property.reference or OneTimeUserProperty.reference, resolved server-side
  email     String // guest email, or the authenticated user's account email — always the delivery address
  userId    String? // set for the authenticated (Property) path; audit only, ownership is re-checked at verify time regardless
  target    String // "report" | "document:0" | "document:1" | ... — which S3-backed field this code authorizes
  codeHash  String // sha256(rawCode) — the raw code is never persisted
  attempts  Int       @default(0) // wrong-guess counter against this specific row, capped independently of the IP-scoped rate limiter
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([reference, target, email, createdAt])
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// Placeholder User model for relation
model RevaUser {
  id      String @id @default(uuid()) // Unique identifier
  kindeId String @unique
  email   String @unique

  firstName String
  lastName  String

  role          Role    @default(USER)
  emailVerified Boolean @default(false)
  is_active     Boolean @default(true)

  /// Native email+password auth (§4.2) — null if this account has never set
  /// a password (Kinde-only). authProviders lets one account have both.
  passwordHash  String?
  authProviders AuthProvider[] @default([KINDE])

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  properties Property[]
}

/// Trail of admin-side actions on REVA (inviting/creating admins, role and
/// status changes, deletions). `userId` is the user who performed the action,
/// never the account it was performed on — that goes in `entityId`. Mirrors
/// GBCAuditLog/SurfboardAuditLog.
model RevaAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("reva_audit_logs")
}
