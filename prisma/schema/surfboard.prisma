// --------------------------------------------------------------------------------
// Surfboard — survey-plan management and Certificate of Deposit (CoD) system for
// licensed surveyors in Lagos State, with a multi-role MDA approval pipeline and
// a QR-code-based public verification/earnings layer.
// --------------------------------------------------------------------------------

enum SurfboardRole {
  USER
  ADMIN
  SUPERADMIN
  RECORDS_I // MDA Role: Verifies record copies
  INTAKE // MDA Role: Verifies physical copies (grouped by batch)
  RECORDS_II // MDA Role: Final verification of physical copies and submits to OSSG
  ACCOUNTS // MDA Role: Approves LASG payment receipts
  CHARTING // MDA Role: Edits/confirms charting remarks
  SURCON // MDA Role: Confirms pillar numbers
  MDA_SUPERADMIN // MDA Role: Can view all activities of all MDA users
  ARCHIVE // MDA Role: Manages arched/received plans
}

enum PayerIDType {
  Individual
  Commercial
}

model SurfboardUser {
  id                       String        @id @default(uuid())
  kindeId                  String        @unique
  email                    String        @unique
  firstName                String
  lastName                 String
  role                     SurfboardRole @default(USER)
  emailVerified            Boolean       @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  isActive       Boolean @default(true)
  isKycValidated Boolean @default(false)

  /// Native email+password auth (§4.2) — null if this account has never set
  /// a password (Kinde-only). authProviders lets one account have both.
  passwordHash  String?
  authProviders AuthProvider[] @default([KINDE])

  // New fields
  logo            String? // URL to the user's logo
  companyName     String? // User's company name
  companyAddress  String? // User's company address
  surconRegNumber String?      @unique @default(dbgenerated("concat('SURCON_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 5))"))
  surconRegName   String? // Name as registered with SURCON
  signature       String? // URL to the user's signature image
  prefix          String? // Name prefix (e.g., Mr., Mrs., Dr.)
  suffix          String? // Name suffix (e.g., Jr., Sr., III)
  residenceState  String? // Residence state in Nigeria
  postalCode      String? // User's postal code
  phoneNumber     String? // User's phone number
  address         String? // User's address
  payerID         Int? // Payer ID
  payerIDType     PayerIDType? // Type of payer: Individual or Commercial

  // Relations
  plans               SurfboardPlan[]             @relation("PlanOwner")
  subscription        Subscription[]
  subscriptionHistory SubscriptionHistory[]
  batches             CertificateOfDepositBatch[]
  settingsUpdates     SurfboardSettings[]
  wallet              SurveyorWallet?
  bankDetails         SurveyorBankDetails?
  withdrawalRequests  WithdrawalRequest[]
  qrTransactions      QREarningsTransaction[]     @relation("SurveyorQREarnings")

  // MDA Approval Relations (reverse)
  plansApprovedAsAccounts   SurfboardPlan[]             @relation("AccountsApprover")
  plansApprovedAsCharting   SurfboardPlan[]             @relation("ChartingApprover")
  plansApprovedAsSurcon     SurfboardPlan[]             @relation("SurconApprover")
  plansApprovedAsRecordsI   SurfboardPlan[]             @relation("RecordsIApprover")
  plansApprovedAsIntake     SurfboardPlan[]             @relation("IntakeApprover")
  plansApprovedAsRecordsII  SurfboardPlan[]             @relation("RecordsIIApprover")
  batchesApprovedAsAccounts CertificateOfDepositBatch[] @relation("BatchAccountsApprover")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metadata Json? @default("{}")

  @@map("SurfboardUser")
}

enum SurfboardPlanStatus {
  PENDING
  LODGED // APPROVED
  QUERIED
  UNDER_REVIEW
}

enum SurfboardRedCopyStatus {
  NOT_SUBMITTED
  SUBMITTED
  COMPLETED
  FAILED
  APPROVED // Certificate of Deposit approved
  QUERIED // Queried by any MDA role
}

model Subscription {
  id     String        @id @default(uuid())
  userId String        @unique
  user   SurfboardUser @relation(fields: [userId], references: [id])

  provider        String    @default("paystack")
  email           String?
  customerCode    String?
  customerId      String?
  emailToken      String? // required to enable/disable
  authorization   String?
  subCode         String? // Paystack subscription ID
  planCode        String
  planName        String
  interval        String    @default("monthly") // 'monthly' | 'quarterly' | 'yearly'
  amount          Int
  currency        String    @default("NGN")
  currentStart    DateTime?
  currentEnd      DateTime?
  cancelledAt     DateTime?
  nextPaymentDate DateTime?
  status          String // active, canceled, expired, etc.
  platform        String    @default("surfboard") // surfboard or twonodes or reva or scram

  // Dedupe marker for the expiry-reminder cron (email + WhatsApp) — set once
  // a reminder has gone out for the subscription's *current* expiry date, so
  // a renewal (which bumps currentEnd) naturally allows a fresh reminder later.
  expiryReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Subscription")
}

model SubscriptionHistory {
  id        String @id @default(uuid())
  reference String

  userId String
  user   SurfboardUser @relation(fields: [userId], references: [id])

  planCode        String
  planName        String
  amount          Int // Amount in kobo
  interval        String    @default("monthly") // 'monthly' | 'quarterly' | 'yearly'
  lastPaymentDate DateTime?
  startDate       DateTime?
  endDate         DateTime?
  status          String // 'active' | 'past_due' | 'canceled'
  eventType       String // "subscription.create", "subscription.disable", "invoice.success", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@map("SubscriptionHistory")
}

/// A single survey plan record.
/// Geometry is stored as raw GeoJSON in JSONB; pillars are in JSONB.
model SurfboardPlan {
  /// PK: auto-generated UUID
  id String @id @default(uuid()) @db.Uuid

  /// User-entered reference number
  planNumber String @unique

  /// Descriptive title
  surveyTitle String

  /// Category (e.g. APPROVED LAYOUT, DEED)
  planType String

  /// Optional link to a previous plan
  referencePlanNumber String?

  /// Recorded deeded area (free-text)
  deededArea String

  /// Surveyor/facilitator name
  facilitator String

  /// Type of survey pillar
  pillarType String

  /// Raw GeoJSON polygon stored as JSONB
  geometry Json

  /// S3 URLs for uploaded files
  pdfFilePaths         String[] @default([])
  cadFilePaths         String[] @default([])
  certificateFilePaths String[] @default([])

  /// Date when the plan was lodged
  dateLodged DateTime?

  /// Red Copy submission status
  redCopyStatus      SurfboardRedCopyStatus @default(NOT_SUBMITTED) // NOT_SUBMITTED, SUBMITTED, COMPLETED, FAILED
  redCopySubmittedAt DateTime? // When the Red Copy was submitted
  redCopyFileUrl     String? // URL to the uploaded Red Copy file
  redCopyError       String? // Error message if Red Copy submission failed

  // Certificate of Deposit fields
  locality                String? // New field for locality
  possibleChartingRemarks String? // Populated from LASG_charting_interpretation
  chartingRemarks         String? // Final charting remarks (edited by Charting Admin)
  batchId                 String? // Reference to batch submission
  batch                   CertificateOfDepositBatch? @relation(fields: [batchId], references: [id])

  // Approval tracking - Accounts
  accountsApprovedBy     String?
  accountsApprovedByUser SurfboardUser?  @relation("AccountsApprover", fields: [accountsApprovedBy], references: [id])
  accountsApprovedAt     DateTime?
  accountsStatus         ApprovalStatus? @default(PENDING)
  accountsComment        String?
  accountsLockedBy       String? // User ID who locked this plan for accounts review
  accountsLockedAt       DateTime? // When the lock was acquired
  accountsLockExpiresAt  DateTime? // When the lock expires (30 min from lock time)

  // Approval tracking - Charting
  chartingApprovedBy     String?
  chartingApprovedByUser SurfboardUser?  @relation("ChartingApprover", fields: [chartingApprovedBy], references: [id])
  chartingApprovedAt     DateTime?
  chartingStatus         ApprovalStatus? @default(PENDING)
  chartingComment        String?
  chartingLockedBy       String? // User ID who locked this plan for charting review
  chartingLockedAt       DateTime? // When the lock was acquired
  chartingLockExpiresAt  DateTime? // When the lock expires

  // Approval tracking - SURCON
  surconApprovedBy     String?
  surconApprovedByUser SurfboardUser?  @relation("SurconApprover", fields: [surconApprovedBy], references: [id])
  surconApprovedAt     DateTime?
  surconStatus         ApprovalStatus? @default(PENDING)
  surconComment        String?
  surconLockedBy       String? // User ID who locked this plan for SURCON review
  surconLockedAt       DateTime? // When the lock was acquired
  surconLockExpiresAt  DateTime? // When the lock expires

  // Approval tracking - Records I
  recordsIApprovedBy     String?
  recordsIApprovedByUser SurfboardUser?  @relation("RecordsIApprover", fields: [recordsIApprovedBy], references: [id])
  recordsIApprovedAt     DateTime?
  recordsIStatus         ApprovalStatus? @default(PENDING)
  recordsIComment        String?
  recordsILockedBy       String? // User ID who locked this plan for Records I review
  recordsILockedAt       DateTime? // When the lock was acquired
  recordsILockExpiresAt  DateTime? // When the lock expires

  // Physical copy tracking
  physicalCopySubmitted   Boolean   @default(false)
  physicalCopySubmittedAt DateTime?

  // Record Copy Verification
  recordCopyVerifiedAt       DateTime?
  recordCopyVerdict          String? // "VERIFIED", "REVIEW", "NOT_VERIFIED", "ERROR"
  recordCopyVerificationData Json?

  // Approval tracking - Intake
  intakeApprovedBy     String?
  intakeApprovedByUser SurfboardUser?  @relation("IntakeApprover", fields: [intakeApprovedBy], references: [id])
  intakeApprovedAt     DateTime?
  intakeStatus         ApprovalStatus? @default(PENDING)
  intakeComment        String?
  intakeLockedBy       String? // User ID who locked this plan for Intake review
  intakeLockedAt       DateTime? // When the lock was acquired
  intakeLockExpiresAt  DateTime? // When the lock expires

  // Approval tracking - Records II
  recordsIIApprovedBy     String?
  recordsIIApprovedByUser SurfboardUser?  @relation("RecordsIIApprover", fields: [recordsIIApprovedBy], references: [id])
  recordsIIApprovedAt     DateTime?
  recordsIIStatus         ApprovalStatus? @default(PENDING)
  recordsIIComment        String?
  recordsIILockedBy       String? // User ID who locked this plan for Records II review
  recordsIILockedAt       DateTime? // When the lock was acquired
  recordsIILockExpiresAt  DateTime? // When the lock expires

  // Archive Tracking
  archiveReceivedBy String?
  archiveReceivedAt DateTime?
  archiveNotes      String?

  // Location fields
  ward  String?
  lcda  String?
  lga   String?
  state String?

  // Zone-based fee calculation fields
  zone        String? // Detected zone from Scale_of_fees (e.g., "lagosZoneA", "lagosZoneB")
  codFee      Float? // Calculated CoD fee for this plan
  isDoubleFee Boolean @default(false) // True if corporate or >2 names in survey title
  ethnicity   String? // "hausa", "igbo", "yoruba" or "corporate" - used for double fee detection

  /// Array of pillar objects
  pillars Json

  /// Date on the survey plan document
  dateOnSurveyPlan DateTime?

  /// Reason required when planType is "Withdrawal and Resubmission"
  reasonForWithdrawalAndResubmission String?

  /// Withdrawal and Resubmission status tracking
  /// Values: "No_Action" (default), "Withdrawn", "Resubmitted"
  withdrawalAndResubmissionStatus String? @default("No_Action")

  /// Reference plan triggered by adjoining pillar type (REGULAR+ADJOINING, SPECIAL+ADJOINING)
  pillarTypeReferencePlanNumber String?

  /// Per-parcel metadata for MultiPolygon plans (survey titles, locations)
  parcels Json? // Array of ParcelInfo objects

  /// Workflow status (default PENDING)
  status SurfboardPlanStatus @default(PENDING)

  /// Draft vs. published
  isLive Boolean @default(false)

  /// Person Count Validation
  personCount         Int     @default(1)
  personCountVerified Boolean @default(false)

  /// Reference to the user who created this plan
  userId String?
  user   SurfboardUser? @relation("PlanOwner", fields: [userId], references: [id])

  sharedTo       String[]
  shareResponses SurfboardPlanShareResponse[]
  shareInvites   SurfboardPlanShareInvite[]

  /// Soft delete fields
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String? // User ID who deleted the plan

  // Query Fee Receipts
  queryLasgReceiptUrls   String[] @default([])
  queryRemitaReceiptUrls String[] @default([])

  // QR Code Earnings tracking
  qrScanCount    Int                     @default(0)
  qrTransactions QREarningsTransaction[]

  /// Creation & update timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Index by reference number
  @@index([planNumber])
  @@index([deleted])
}

enum SurfboardNotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  PLAN
  SHARING
}

enum SurfboardNotificationAudience {
  SPECIFIC_USERS
  GENERAL_ADMINS
  SUPERADMIN
  ALL_USERS
}

model SurfboardNotification {
  id          String                        @id @default(cuid())
  type        SurfboardNotificationType
  title       String
  message     String
  readBy      String[]                      @default([]) // List of userIds who read it
  dismissedBy String[]                      @default([]) // List of userIds who dismissed it
  userIds     String[]                      @default([]) // If null/empty => general
  audience    SurfboardNotificationAudience @default(SPECIFIC_USERS)
  link        String?
  metadata    Json?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([createdAt])
  @@index([audience])
}

// --------------------------------------------------------------------------------
// Certificate of Deposit System
// --------------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  QUERIED
}

enum BatchPaymentStatus {
  PENDING_USER_PAYMENT
  LASG_PAID
  ACCOUNTS_APPROVED
  ACCOUNTS_DISAPPROVED
  COMPLETED
}

/// LGA Fee Configuration - Editable by Super Admin
model LGAFeeConfig {
  id                  String   @id @default(uuid())
  lgaName             String   @unique
  ratePerSqM          Float // Rate per square meter in Naira
  systemChargePercent Float    @default(10) // System charge percentage
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([lgaName])
}

/// Certificate of Deposit Batch Submission
model CertificateOfDepositBatch {
  id        String @id @default(uuid())
  batchCode String @unique @default(dbgenerated("concat('SurfCoD_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 8))"))

  // Submitter
  submittedBy String
  submitter   SurfboardUser @relation(fields: [submittedBy], references: [id])

  // Plans in this batch
  plans     SurfboardPlan[]
  planCount Int             @default(0)

  // Fee Calculation
  totalFees     Float // Sum of all plan fees
  systemCharges Float // 10% of total fees
  totalAmount   Float // totalFees + systemCharges

  // Payment Status
  paymentStatus BatchPaymentStatus @default(PENDING_USER_PAYMENT)

  // User Payment (Fold 1)
  userPaymentRef String? @unique @default(dbgenerated("concat('SurfCoDRef_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 8))"))

  userPaymentDate   DateTime?
  userPaymentAmount Float?

  // LASG Payment (Fold 2)
  lasgReceiptUrl        String? // Uploaded receipt
  lasgReceiptS3Key      String?
  remitaReceiptUrl      String? // Remita receipt URL (from two-link flow)
  paymentAnchor         String? // Cross-validation anchor linking LASG and Remita receipts (e.g., "169767640-8154445-175")
  lasgPaymentDate       DateTime?
  lasgReceiptUploadedBy String?
  lasgReceiptUploadedAt DateTime?

  // Accounts Approval
  accountsApprovedBy     String?
  accountsApprovedByUser SurfboardUser? @relation("BatchAccountsApprover", fields: [accountsApprovedBy], references: [id])
  accountsApprovedAt     DateTime?
  accountsDisapproved    Boolean        @default(false)
  accountsComment        String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchCode])
  @@index([submittedBy])
  @@index([paymentStatus])
}

/// Surfboard Application Settings
model SurfboardSettings {
  id               String   @id @default(cuid())
  /// Stores the entire application configuration as a JSON object.
  /// Structure: {
  ///   zoneFees: [{range, start, end, lagosZoneA, lagosZoneB, lagosZoneC, lagosZoneD}, ...],
  ///   systemChargePercent: 10,
  ///   ... other settings
  /// }
  settings         Json     @default("{}")
  previousSettings Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  updatedById String?
  updatedBy   SurfboardUser? @relation(fields: [updatedById], references: [id])

  @@map("surfboard_settings")
}

// --------------------------------------------------------------------------------
// QR Code Earnings Models
// --------------------------------------------------------------------------------

enum QRServiceType {
  LOCATION_AUTHENTICITY
  CERTIFICATE_OF_DEPOSIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model QREarningsTransaction {
  id        String        @id @default(uuid())
  reference String        @unique
  planId    String        @db.Uuid
  plan      SurfboardPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  surveyorId String
  surveyor   SurfboardUser @relation("SurveyorQREarnings", fields: [surveyorId], references: [id])

  serviceType     QRServiceType
  verificationFee Float
  serviceFee      Float
  mdaFee          Float         @default(0)
  totalAmount     Float
  surveyorEarned  Float

  payerEmail    String?
  payerName     String?
  paymentStatus String  @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentRef    String?

  accessToken String    @unique @default(uuid())
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([surveyorId])
  @@index([reference])
  @@index([accessToken])
  @@map("qr_earnings_transactions")
}

model SurveyorWallet {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              SurfboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance  Float         @default(0)
  pendingWithdrawal Float         @default(0)
  totalWithdrawn    Float         @default(0)
  totalEarned       Float         @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("surveyor_wallets")
}

model SurveyorBankDetails {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          SurfboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  recipientCode String? // Paystack Transfer Recipient Code (e.g. RCP_12345)
  isVerified    Boolean       @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("surveyor_bank_details")
}

model WithdrawalRequest {
  id            String           @id @default(uuid())
  requestRef    String           @unique @default(dbgenerated("concat('WD_', substring(replace(gen_random_uuid()::text, '-', ''), 1, 8))"))
  userId        String
  user          SurfboardUser    @relation(fields: [userId], references: [id])
  amount        Float
  status        WithdrawalStatus @default(PENDING)
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String?
  transferCode  String? // Paystack transfer code e.g. TRF_xxx
  adminComment  String?
  processedAt   DateTime?
  processedBy   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

model SurfboardAuditLog {
  id        String   @id @default(cuid())
  userId    String? // User who performed the action
  action    String // Action performed (e.g., "CREATE_PLAN", "APPROVE_BATCH")
  entity    String // Entity affected (e.g., "SurfboardPlan", "CertificateOfDepositBatch")
  entityId  String? // ID of the entity affected
  changes   String?  @db.Text // JSON string of changes made
  ipAddress String? // IP address of the user
  userAgent String? // Browser user agent
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("surfboard_audit_logs")
}

/// Tracks whether a recipient has acknowledged a shared plan, alongside the
/// existing `SurfboardPlan.sharedTo` membership list (which only records who
/// a plan is shared with, not whether they've responded).
model SurfboardPlanShareResponse {
  id               String        @id @default(uuid())
  planId           String        @db.Uuid
  plan             SurfboardPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sharedByUserId   String
  sharedWithUserId String
  sharedAt         DateTime      @default(now())
  respondedAt      DateTime?
  response         String?

  @@unique([planId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
  @@map("surfboard_plan_share_responses")
}

/// Shares a plan with an email address that has no SurfboardUser account yet
/// (mirrors AdminInvitation's token/hash/expiry shape — see
/// lib/auth/adminInvitations.ts — but grants plan access on acceptance
/// rather than creating a staff account). Resolved automatically the moment
/// a SurfboardUser row with a matching email is created (see the surfboard
/// Kinde auth-success callback), not via a manual accept step — matches the
/// "immediate access" decision for existing-user shares.
model SurfboardPlanShareInvite {
  id               String        @id @default(uuid())
  planId           String        @db.Uuid
  plan             SurfboardPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  email            String
  tokenHash        String        @unique
  sharedByUserId   String
  invitedAt        DateTime      @default(now())
  expiresAt        DateTime
  acceptedByUserId String?
  acceptedAt       DateTime?

  @@index([email])
  @@index([planId])
  @@map("surfboard_plan_share_invites")
}
