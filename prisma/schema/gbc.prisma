// --------------------------------------------------------------------------------
// GBC — Geospatial Builders Conference 2.0 ticketing/event-management platform.
// --------------------------------------------------------------------------------

enum GBCProfession {
  SURVEYOR
  GIS_ANALYST
  URBAN_PLANNER
  LAWYER
  ENGINEER
  ARCHITECT
  DATA_SCIENTIST
  DEVELOPER
  PROJECT_MANAGER
  STUDENT
  RESEARCHER
  ENTREPRENEUR
  GOVERNMENT_OFFICIAL
  NGO_STAFF
  CONSULTANT
  OTHER
}

enum GBCRole {
  USER
  ADMIN
  SUPERADMIN
}

enum GBCGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GBCTicketType {
  EARLY_BIRD
  REGULAR
  COMPANY
  VIP
  STUDENT
}

enum GBCPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model GBCUser {
  id        String   @id @default(cuid())
  kindeId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  role      GBCRole  @default(USER)
  isActive  Boolean  @default(true)

  /// Native email+password auth (§4.2) — null if this account has never set
  /// a password (Kinde-only). authProviders lets one account have both.
  passwordHash  String?
  authProviders AuthProvider[] @default([KINDE])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kindeId])
  @@index([email])
  @@index([isActive])
}

model GBCTicket {
  id             String           @id @default(cuid())
  /// Generated in ticketService.ts from the active edition's ticketPrefix,
  /// not a DB default — see GBCSettings.settings.editions.
  ticketNumber   String           @unique
  /// Categorical tag, not a FK (same reasoning as REVA's Property.reference
  /// uniqueness being app-level) — matches GBCSettings.settings.editions[].key.
  edition        String           @default("2.0")
  name           String
  email          String
  phone          String?
  gender         GBCGender
  profession     String           @default("")
  ticketType     GBCTicketType
  price          Int
  paymentStatus  GBCPaymentStatus @default(PENDING)
  // paymentRef is unique for non-COMPANY tickets, but COMPANY tickets can share the same reference (group purchases)
  // Uniqueness is enforced at the application level in ticket-actions.ts
  paymentRef     String?
  paymentDate    DateTime?
  paymentMethod  String?
  paymentDetails Json?
  qrCode         String?
  qrCodeS3Key    String?
  checkedIn      Boolean          @default(false)
  checkedInAt    DateTime?
  checkedInBy    String?
  certificateSentCount Int      @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([email])
  @@index([phone])
  @@index([ticketNumber])
  @@index([paymentRef])
  @@index([paymentStatus])
  @@index([edition])
  @@map("gbc_tickets")
}

model GBCSponsor {
  id          String         @id @default(cuid())
  name        String
  logo        String
  logoS3Key   String?
  tier        GBCSponsorTier
  description String?        @db.Text
  website     String?
  order       Int            @default(0)
  visible     Boolean        @default(true)
  edition     String         @default("2.0")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([edition])
  @@map("gbc_sponsors")
}

enum GBCSponsorTier {
  HEADLINE
  IMPACT
  SUPPORTING
}

model GBCPartner {
  id          String   @id @default(cuid())
  name        String
  logo        String
  logoS3Key   String?
  description String?  @db.Text
  website     String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  edition     String   @default("2.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([edition])
  @@map("gbc_partners")
}

model GBCGallery {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  mediaType      GBCMediaType
  mediaUrl       String
  mediaS3Key     String?
  thumbnailUrl   String?
  thumbnailS3Key String?
  year           Int
  order          Int          @default(0)
  visible        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([year])
  @@map("gbc_gallery")
}

enum GBCMediaType {
  IMAGE
  VIDEO
}

enum GBCSpeakerTier {
  KEYNOTE
  PANELIST
  FIRESIDE_CHAT
}

model GBCSpeaker {
  id         String         @id @default(cuid())
  name       String
  title      String
  bio        String         @db.Text
  photo      String
  photoS3Key String?
  tier       GBCSpeakerTier
  company    String?
  linkedin   String?
  twitter    String?
  order      Int            @default(0)
  visible    Boolean        @default(true)
  featured   Boolean        @default(false)
  edition    String         @default("2.0")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([edition])
  @@map("gbc_speakers")
}

model GBCPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gbc_pages")
}

model GBCSettings {
  id               String   @id @default(cuid())
  /// Stores the entire application configuration as a JSON object.
  /// Structure: GBCSettingsData (see utils/settings.ts)
  /// {
  ///   event: { name, theme, date, venue, time, ... },
  ///   tickets: { earlyBirdPrice, regularPrice, maxCapacity, ... },
  ///   notifications: { emailTicketConfirmation, ... },
  ///   system: { maintenanceMode, ... }
  /// }
  settings         Json     @default("{}")
  previousSettings Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("gbc_settings")
}

model GBCContactInquiry {
  id        String           @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String           @db.Text
  type      String?
  status    GBCInquiryStatus @default(PENDING)
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@index([type])
  @@map("gbc_contact_inquiries")
}

enum GBCInquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model GBCEventStats {
  id            String   @id @default(cuid())
  date          DateTime @unique @default(now())
  ticketsSold   Int      @default(0)
  revenue       Int      @default(0)
  checkedIn     Int      @default(0)
  newInquiries  Int      @default(0)
  websiteVisits Int      @default(0)
  emailsSent    Int      @default(0)
  smsSent       Int      @default(0)
  edition       String   @default("2.0")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([edition])
  @@map("gbc_event_stats")
}

model GBCNotification {
  id        String                @id @default(cuid())
  type      GBCNotificationType
  recipient String
  subject   String?
  message   String                @db.Text
  status    GBCNotificationStatus @default(PENDING)
  sentAt    DateTime?
  error     String?               @db.Text
  metadata  String?               @db.Text
  createdAt DateTime              @default(now())

  @@index([status])
  @@index([type])
  @@map("gbc_notifications")
}

enum GBCNotificationType {
  EMAIL
  SMS
  PUSH
}

enum GBCNotificationStatus {
  PENDING
  SENT
  FAILED
  QUEUED
}

model GBCAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("gbc_audit_logs")
}
